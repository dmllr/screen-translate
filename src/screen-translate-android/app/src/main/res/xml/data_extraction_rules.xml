<?xml version="1.0" encoding="utf-8"?>
<!-- Models are large and re-downloadable: never back them up. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="file" path="models/" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="file" path="models/" />
  </device-transfer>
</data-extraction-rules>
